Options -Indexes
DirectoryIndex archive.php
RewriteEngine On

# Never expose private configuration, includes, dotfiles or local secrets.
RewriteRule ^private(?:/|$) - [F,L,NC]
RewriteRule ^inc(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:config\.local\.php|\.env(?:\..*)?)$ - [F,L,NC]

# Keep the old all-in-one page archived but out of the public structure.
RewriteRule ^index\.php$ / [R=302,L]

# Historical PHP generators are archived source, not public endpoints.
RewriteRule ^coin/.*\.php$ - [F,L,NC]
RewriteRule ^bullshiter\.php$ - [F,L,NC]

# Never execute arbitrary PHP files from archival/data folders.
RewriteRule ^(?:JSON_1-128|coin_1-128|CoinThumb_1-128|shitpix_jpg_1-128|shitpix_pdf_1-128)/.*\.php$ - [F,L,NC]

# Public structure.
RewriteRule ^lore/?$ lore.php [L,QSA]
RewriteRule ^oracle/?$ oracle.php [L,QSA]
RewriteRule ^draw/?$ draw.php [L,QSA]
RewriteRule ^crtsht/[0-9]{1,3}/?$ record.php [L,QSA]
RewriteRule ^[0-9]{1,3}/?$ record.php [L,QSA]

# Static artwork filenames are immutable archival assets: cache aggressively.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(?:jpg|jpeg|png|webp|gif)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

# Existing static archival assets remain directly readable.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

FallbackResource /archive.php
