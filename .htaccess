Options -Indexes
RewriteEngine On

# Never serve configuration/include files.
RewriteRule ^inc/ - [F,L]

# Historical generator scripts are archived source, not web endpoints.
RewriteRule ^coin/.*\.php$ - [F,L,NC]
RewriteRule ^bullshiter\.php$ - [F,L,NC]

# Keep original metadata and archival assets directly readable.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Canonical work URLs: /crtsht/1 ... /crtsht/128
RewriteRule ^crtsht/[0-9]{1,3}/?$ index.php [L,QSA]
RewriteRule ^[0-9]{1,3}/?$ index.php [L,QSA]

# Everything else returns to the archive application.
FallbackResource /index.php
